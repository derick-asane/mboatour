// Mboatour — touristic sites, events and visits.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Authority over the whole platform, separate from any single site.
enum PlatformRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum SiteVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SiteRole {
  OWNER
  ADMIN
}

enum SitePermission {
  MANAGE_SITE
  MANAGE_EVENTS
  MANAGE_MEMBERS
  MANAGE_BOOKINGS
  MANAGE_VISITS
  MANAGE_GUIDES
}

/// A guide profile is public only once the platform has checked who it belongs
/// to. Endorsements are a separate, per-site signal on top.
enum GuideStatus {
  DRAFT
  PENDING
  VERIFIED
  SUSPENDED
}

enum EndorsementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  MTN_MOMO
  ORANGE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VisitRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Accounts (Auth.js + credentials)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  platformRole  PlatformRole @default(MEMBER)
  locale        String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  memberships          SiteMember[]
  createdSites         TouristicSite[] @relation("SiteCreator")
  createdEvents        Event[]         @relation("EventCreator")
  bookings             Booking[]
  visitRequests        VisitRequest[]  @relation("VisitRequester")
  reviewedVisitRequest VisitRequest[]  @relation("VisitReviewer")
  guideProfile         GuideProfile?
  verifiedGuides       GuideProfile[]  @relation("GuideVerifier")
  decidedEndorsements  GuideEndorsement[] @relation("EndorsementDecider")
  reviews              Review[]        @relation("ReviewAuthor")
  hiddenReviews        Review[]        @relation("ReviewModerator")
  reviewReplies        Review[]        @relation("ReviewResponder")
  verifiedSites        TouristicSite[] @relation("SiteVerifier")
  eventMessages        EventMessage[]  @relation("MessageAuthor")
  moderatedMessages    EventMessage[]  @relation("MessageModerator")
  chatMutes            EventChatMute[] @relation("MutedParticipant")
  mutesIssued          EventChatMute[] @relation("MuteModerator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Touristic sites
// ---------------------------------------------------------------------------

model TouristicSite {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  summary       String?
  description   String?
  category      String?
  address       String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?
  coverImageUrl String?
  openingHours  String?
  entryFeeCents Int      @default(0)
  currency      String   @default("XAF")
  published     Boolean  @default(false)
  verification     SiteVerificationStatus @default(UNVERIFIED)
  verificationNote String?
  verifiedAt       DateTime?
  verifiedById     String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User           @relation("SiteCreator", fields: [createdById], references: [id])
  verifiedBy    User?          @relation("SiteVerifier", fields: [verifiedById], references: [id])
  members       SiteMember[]
  events        Event[]
  visitRequests VisitRequest[]
  images        SiteImage[]
  reviews       Review[]
  endorsements  GuideEndorsement[]

  /// Kept alongside the reviews so listings and cards need no aggregate query.
  ratingAverage Float?
  ratingCount   Int     @default(0)

  @@index([published])
  @@index([verification])
  @@index([createdById])
}

/// A user's admin seat on a site. The creator gets OWNER with every permission;
/// extra admins are granted a subset via `permissions`.
model SiteMember {
  id          String           @id @default(cuid())
  userId      String
  siteId      String
  role        SiteRole         @default(ADMIN)
  permissions SitePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  site TouristicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Events & bookings
// ---------------------------------------------------------------------------

model Event {
  id            String      @id @default(cuid())
  siteId        String
  title         String
  slug          String
  description   String?
  startsAt      DateTime
  endsAt        DateTime?
  capacity      Int?
  priceCents    Int         @default(0)
  currency      String      @default("XAF")
  location      String?
  coverImageUrl String?
  status        EventStatus @default(DRAFT)
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  site      TouristicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User          @relation("EventCreator", fields: [createdById], references: [id])
  bookings  Booking[]
  images    EventImage[]
  messages  EventMessage[]
  chatMutes EventChatMute[]

  @@unique([siteId, slug])
  @@index([siteId, startsAt])
  @@index([status, startsAt])
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique
  eventId   String
  userId    String
  seats       Int           @default(1)
  status      BookingStatus @default(PENDING)
  note        String?
  attendeeName  String?
  attendeePhone String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment?

  // One booking per user per event; seat count carries the party size.
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Visit requests
// ---------------------------------------------------------------------------

model VisitRequest {
  id           String             @id @default(cuid())
  siteId       String
  userId       String
  visitDate    DateTime
  partySize    Int                @default(1)
  message      String?
  status       VisitRequestStatus @default(PENDING)
  responseNote String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  site       TouristicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user       User          @relation("VisitRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("VisitReviewer", fields: [reviewedById], references: [id])

  @@index([siteId, status])
  @@index([userId])
}

/// A photo of a site, uploaded by its team and served from `public/uploads`.
model SiteImage {
  id        String   @id @default(cuid())
  siteId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  site TouristicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, sortOrder])
}

/// A photo of an event, uploaded by the site team alongside its cover.
model EventImage {
  id        String   @id @default(cuid())
  eventId   String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

// ---------------------------------------------------------------------------
// Event chat
// ---------------------------------------------------------------------------

/// A message in an event group chat. Who may read or post is derived from
/// bookings and site membership, so there is no participant list to keep in
/// sync. Deletions are soft: moderation leaves a trail.
model EventMessage {
  id          String    @id @default(cuid())
  eventId     String
  userId      String
  /// Empty when the message is nothing but a picture.
  body          String
  attachmentUrl String?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  deletedById String?

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation("MessageAuthor", fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("MessageModerator", fields: [deletedById], references: [id])

  @@index([eventId, createdAt])
}

/// A participant the site team has silenced for one event. Reading continues;
/// posting does not.
model EventChatMute {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  mutedById String
  reason    String?
  createdAt DateTime @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation("MutedParticipant", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy User  @relation("MuteModerator", fields: [mutedById], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

/// What was collected for a booking. Card numbers never reach this table or
/// this server: the browser keeps the number and sends only the last four
/// digits, which is all a receipt needs.
model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  amountCents Int
  currency    String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  /// Which adapter handled it: "mock" until a real aggregator is configured.
  provider    String
  providerRef String?
  payerPhone  String?
  cardLast4   String?
  failureCode String?
  paidAt      DateTime?
  refundedAt  DateTime?
  refundRef   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

/// One rating per person per site, left only by someone who actually went:
/// a booking on an event that has finished, or an approved visit whose date
/// has passed. That is what separates these from ratings anyone can invent.
model Review {
  id        String   @id @default(cuid())
  siteId    String
  userId    String
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?

  /// The site team may answer a review, but never remove one: hiding is left
  /// to platform admins, so a site cannot bury what it dislikes.
  reply       String?
  repliedAt   DateTime?
  repliedById String?

  hiddenAt   DateTime?
  hiddenById String?

  site        TouristicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user        User          @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  hiddenBy    User?         @relation("ReviewModerator", fields: [hiddenById], references: [id])
  repliedBy   User?         @relation("ReviewResponder", fields: [repliedById], references: [id])

  @@unique([siteId, userId])
  @@index([siteId, createdAt])
}

// ---------------------------------------------------------------------------
// Tour guides
// ---------------------------------------------------------------------------

/// A guide belongs to the person, not to a site: the same guide can take
/// visitors round several places, which is why a traveller does not have to
/// find a new one at every gate. Sites endorse guides they know, which is a
/// badge rather than a gate.
model GuideProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  slug            String      @unique
  headline        String
  bio             String
  languages       String[]
  city            String?
  country         String?
  phone           String?
  whatsapp        String?
  photoUrl        String?
  hourlyRateCents Int?
  dailyRateCents  Int?
  currency        String      @default("XAF")
  yearsExperience Int?
  status          GuideStatus @default(DRAFT)
  reviewNote      String?
  verifiedAt      DateTime?
  verifiedById    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy   User?              @relation("GuideVerifier", fields: [verifiedById], references: [id])
  endorsements GuideEndorsement[]

  @@index([status])
  @@index([city])
}

/// A site vouching for a guide it works with.
model GuideEndorsement {
  id           String            @id @default(cuid())
  guideId      String
  siteId       String
  status       EndorsementStatus @default(PENDING)
  note         String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  guide     GuideProfile  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  site      TouristicSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  decidedBy User?         @relation("EndorsementDecider", fields: [decidedById], references: [id])

  @@unique([guideId, siteId])
  @@index([siteId, status])
}
