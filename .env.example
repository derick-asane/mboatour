# PostgreSQL connection string used by Prisma and the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mboatour?schema=public"

# Secret used by Auth.js to sign session cookies.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# ---------------------------------------------------------------------------
# Social sign-in (optional)
#
# Each provider appears on the sign-in and sign-up pages only when BOTH of its
# variables below are set, so you can enable them one at a time.
#
# Callback URL to register with every provider — the host and port must match
# the server exactly, so register the port `next dev` actually prints:
#   http://localhost:3000/api/auth/callback/<provider>
# ---------------------------------------------------------------------------

# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add the callback URL above as an authorised redirect URI.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# developers.facebook.com -> your app -> Facebook Login -> Settings.
# Add the callback URL as a Valid OAuth Redirect URI, and request the `email`
# permission. Facebook requires HTTPS, so use a tunnel for local testing.
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# developer.apple.com -> Certificates, Identifiers & Profiles.
# AUTH_APPLE_ID is the Services ID (e.g. com.example.mboatour.web).
# AUTH_APPLE_SECRET is a signed JWT generated from your .p8 key, team ID and
# key ID; it expires after six months and must be regenerated.
#   npx auth add apple          (walks through generating it)
# Apple posts its callback cross-site, which needs Secure cookies: it works
# over HTTPS only, never on plain http://localhost.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ---------------------------------------------------------------------------
# First super administrator, created by `npm run seed:admin`.
# Override these before seeding a real deployment, and change the password from
# the account page once you are signed in.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@mboatour.local"
SUPER_ADMIN_PASSWORD="Admin@Mboatour1"
SUPER_ADMIN_NAME="Platform Admin"

# ---------------------------------------------------------------------------
# Email. With no provider configured, messages are printed to the server log
# instead of being sent, which is what local development wants: a password
# reset link can be followed straight from the terminal.
#
# APP_URL builds the absolute links inside emails. Set it to your real origin
# in production, or reset links will point at localhost.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
EMAIL_FROM="Mboatour <onboarding@resend.dev>"
# Sign up at resend.com, verify a sending domain, then paste the key here.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Payments. With no aggregator configured, charges are simulated: the flow
# completes and is labelled "Test payment" everywhere it appears, so a test
# booking is never mistaken for money received.
#
# To go live, add an adapter in src/server/payments/index.ts for your provider
# (MTN MoMo and Orange Money directly, or an aggregator such as CinetPay,
# Campay or Fapshi that fronts both plus cards) and select it in
# paymentProvider(). Card numbers must go to the provider's hosted page or SDK,
# never through this server: the booking dialog already sends only the last
# four digits.
# ---------------------------------------------------------------------------
